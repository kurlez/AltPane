<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBgBrush" Color="#FFF7F7F8"/>
  <SolidColorBrush x:Key="SettingsBgBrush" Color="#FFF7F7F8"/>
  <SolidColorBrush x:Key="WindowEdgeBrush" Color="#FF1E3AAD"/>
  <SolidColorBrush x:Key="WindowEdgeInnerBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF18181B"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF52525B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF3451D1"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#263451D1"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FFB42323"/>
  <SolidColorBrush x:Key="ButtonBgBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="SearchBgBrush" Color="#08000000"/>
  <SolidColorBrush x:Key="LoadCalmBrush" Color="#663451D1"/>
  <SolidColorBrush x:Key="LoadWarmBrush" Color="#FFB8860B"/>
  <SolidColorBrush x:Key="LoadHotBrush" Color="#FFB42323"/>

  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
</ResourceDictionary>
