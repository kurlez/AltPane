<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBgBrush" Color="#FF181818"/>
  <SolidColorBrush x:Key="SettingsBgBrush" Color="#FF181818"/>
  <SolidColorBrush x:Key="WindowEdgeBrush" Color="#FFB9C6FF"/>
  <SolidColorBrush x:Key="WindowEdgeInnerBrush" Color="#FF101114"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#28FFFFFF"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F4F5"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA1A1AA"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF7C97FF"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#337C97FF"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FFFF8B8B"/>
  <SolidColorBrush x:Key="ButtonBgBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="SearchBgBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="LoadCalmBrush" Color="#667C97FF"/>
  <SolidColorBrush x:Key="LoadWarmBrush" Color="#FFE2B340"/>
  <SolidColorBrush x:Key="LoadHotBrush" Color="#FFFF8B8B"/>

  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
</ResourceDictionary>
