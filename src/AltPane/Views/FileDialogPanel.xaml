<Window x:Class="AltPane.FileDialogPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltPane"
        Width="280"
        Height="32"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource WindowEdgeBrush}"
          BorderThickness="1"
          CornerRadius="4"
          SnapsToDevicePixels="True">
    <DockPanel>
      <Grid x:Name="SearchHost" DockPanel.Dock="Bottom" Height="30" PreviewMouseLeftButtonDown="Search_MouseDown">
        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="10,0,8,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13"/>
        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="8,0,8,0"
                 VerticalContentAlignment="Center" FontSize="13"
                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                 TextChanged="Search_TextChanged"/>
      </Grid>
      <Border x:Name="PopupHost" Visibility="Collapsed" Padding="2,2,2,0">
        <Grid>
          <ListBox x:Name="Rows" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   PreviewMouseLeftButtonUp="Rows_Click">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Path}" Height="24">
                  <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                         Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="11" Margin="8,0,2,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </DockPanel>
  </Border>
</Window>
