<Window x:Class="AltPane.FileDialogPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltPane"
        Width="360"
        Height="248"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
        <Grid>
          <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                   Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                   TextChanged="Search_TextChanged"/>
        </Grid>
      </Border>
      <ListBox x:Name="Rows" Grid.Row="1" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               PreviewMouseLeftButtonUp="Rows_Click">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Kind}"/>
                  <Run Text="  "/>
                  <Run Text="{Binding Path}"/>
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
      <TextBlock x:Name="HintText" Grid.Row="2" Margin="2,6,2,0" FontSize="11"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
  </Border>
</Window>
