<Window x:Class="AltPane.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltPane"
        Width="560"
        Height="840"
        MinWidth="480"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
  <Border Background="{DynamicResource SettingsBgBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel x:Name="TitleBar" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="Title_Drag" Height="44">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="44" Content="×" FontSize="16"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" Click="Close_Click" Cursor="Hand"/>
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="16,0" FontSize="14" FontWeight="SemiBold"/>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>
          <TextBlock x:Name="HotkeyLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="RecordButton" DockPanel.Dock="Right" Style="{DynamicResource ActionButton}" Margin="8,0,0,0" MinWidth="88" Click="Record_Click"/>
            <Border Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <TextBlock x:Name="HotkeyText" VerticalAlignment="Center"/>
            </Border>
          </DockPanel>
          <TextBlock x:Name="HotkeyError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
          <CheckBox x:Name="WinTabBox" Margin="0,4,0,2" Checked="WinTabBox_Changed" Unchecked="WinTabBox_Changed"/>
          <TextBlock x:Name="WinTabNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,4"/>
          <TextBlock x:Name="WinTabState" FontWeight="SemiBold" TextWrapping="Wrap" Margin="22,0,0,10"/>
          <CheckBox x:Name="StickyBox" Margin="0,4,0,2" Checked="StickyBox_Changed" Unchecked="StickyBox_Changed"/>
          <TextBlock x:Name="StickyNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,8"/>
          <CheckBox x:Name="QuickTapBox" Margin="22,0,0,2"/>
          <TextBlock x:Name="QuickTapNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,14"/>

          <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="ThemeBox" Margin="0,0,0,10"/>
          <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="LanguageBox" Margin="0,0,0,10"/>
          <TextBlock x:Name="SizeLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="SizeBox" Margin="0,0,0,10"/>
          <TextBlock x:Name="PlacementLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="PlacementBox" Margin="0,0,0,8"/>
          <CheckBox x:Name="MonitorBadgesBox" Margin="0,0,0,2"/>
          <TextBlock x:Name="MonitorBadgesNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,8"/>
          <CheckBox x:Name="MoveBox" Margin="0,0,0,2"/>
          <TextBlock x:Name="MoveNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,10"/>
          <CheckBox x:Name="LoadBox" Margin="0,0,0,6"/>
          <TextBlock x:Name="SortLabel" FontWeight="SemiBold" Margin="0,4,0,6"/>
          <ComboBox x:Name="SortBox" Margin="0,0,0,8"/>
          <TextBlock x:Name="ThresholdLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="ThresholdHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ComboBox x:Name="ThresholdBox" Margin="0,0,0,10"/>
          <TextBlock x:Name="PinnedLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="PinnedHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBox x:Name="PinnedBox" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Padding="8" Margin="0,0,0,10"/>
          <TextBlock x:Name="DemotedLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="DemotedHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBox x:Name="DemotedBox" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Padding="8" Margin="0,0,0,10"/>
          <CheckBox x:Name="ConfirmKillBox" Margin="0,0,0,6"/>
          <CheckBox x:Name="KillTreeBox" Margin="0,0,0,6"/>
          <CheckBox x:Name="DesktopBox" Margin="0,0,0,6"/>
          <CheckBox x:Name="StartupBox" Margin="0,0,0,6"/>
          <CheckBox x:Name="PauseBox" Margin="0,0,0,6"/>
          <CheckBox x:Name="VerboseBox" Margin="0,0,0,2"/>
          <TextBlock x:Name="VerboseNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,14"/>

          <CheckBox x:Name="LaunchBox" Margin="0,0,0,2"/>
          <TextBlock x:Name="LaunchNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,8"/>
          <CheckBox x:Name="IndexStartBox" Margin="22,0,0,4"/>
          <CheckBox x:Name="IndexStoreBox" Margin="22,0,0,4"/>
          <CheckBox x:Name="IndexDesktopBox" Margin="22,0,0,4"/>
          <CheckBox x:Name="IndexPathBox" Margin="22,0,0,2"/>
          <TextBlock x:Name="IndexPathNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,8"/>
          <CheckBox x:Name="EverythingBox" Margin="22,0,0,2"/>
          <TextBlock x:Name="EverythingNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,6"/>
          <TextBlock x:Name="EverythingStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,6"/>
          <TextBlock x:Name="EverythingHttpLabel" FontWeight="SemiBold" Margin="44,0,0,4"/>
          <TextBlock x:Name="EverythingHttpHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,4"/>
          <TextBox x:Name="EverythingHttpPortBox" Margin="44,0,0,4" Padding="8,4" Width="96" HorizontalAlignment="Left" LostFocus="EverythingHttp_Changed"/>
          <CheckBox x:Name="EverythingHttpFallbackBox" Margin="44,0,0,8" Checked="EverythingHttp_Changed" Unchecked="EverythingHttp_Changed"/>
          <StackPanel Orientation="Horizontal" Margin="44,0,0,8">
            <Button x:Name="EverythingStartButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,0" Click="EverythingStart_Click"/>
            <Button x:Name="EverythingSiteButton" Style="{DynamicResource ActionButton}" Click="EverythingSite_Click"/>
          </StackPanel>
          <TextBlock x:Name="EverythingExtLabel" FontWeight="SemiBold" Margin="44,0,0,4"/>
          <TextBox x:Name="EverythingExtBox" Margin="44,0,0,8" Padding="8,4"/>
          <TextBlock x:Name="EverythingExcludeLabel" FontWeight="SemiBold" Margin="44,0,0,4"/>
          <TextBlock x:Name="EverythingExcludeHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,4"/>
          <TextBox x:Name="EverythingExcludeBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Padding="8" Margin="44,0,0,8"/>
          <TextBlock x:Name="DocumentExtLabel" FontWeight="SemiBold" Margin="44,0,0,4"/>
          <TextBlock x:Name="DocumentExtNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,0,0,4"/>
          <TextBox x:Name="DocumentExtBox" Margin="44,0,0,8" Padding="8,4"/>
          <CheckBox x:Name="ActionHintBox" Margin="44,0,0,10"/>
          <TextBlock x:Name="ExcludedAppsLabel" FontWeight="SemiBold" Margin="22,0,0,6"/>
          <TextBlock x:Name="ExcludedAppsHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,6"/>
          <TextBox x:Name="ExcludedAppsBox" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Padding="8" Margin="22,0,0,14"/>

          <TextBlock x:Name="ExclusionLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="ExclusionHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBox x:Name="ExclusionBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Padding="8"/>

          <TextBlock x:Name="ShortcutTitle" FontWeight="SemiBold" Margin="0,16,0,6"/>
          <TextBlock x:Name="ShortcutBody" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock x:Name="AdminNote" TextWrapping="Wrap" Margin="0,16,0,8"/>
          <Button x:Name="AdminButton" Style="{DynamicResource ActionButton}" HorizontalAlignment="Left" Click="Admin_Click"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button x:Name="CancelButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,0" MinWidth="88" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Style="{DynamicResource ActionButton}" MinWidth="88" IsDefault="True" Click="Save_Click"/>
          </StackPanel>
          <Button x:Name="AboutButton" Content="关于" Style="{DynamicResource ActionButton}" VerticalAlignment="Center" Click="About_Click"/>
          <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
