<Window x:Class="AltPane.HintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="360"
        Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        TextOptions.TextFormattingMode="Display">
  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource WindowEdgeBrush}"
          BorderThickness="1"
          Padding="16,12"
          Cursor="Hand"
          MouseLeftButtonDown="Surface_Click">
    <Grid IsHitTestVisible="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ArrowText"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
        <Border x:Name="HostChip"
                Width="26"
                Height="26"
                CornerRadius="7"
                BorderThickness="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Visibility="Collapsed">
          <TextBlock x:Name="HostNumberText"
                     FontSize="13"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="MoveText"
                   FontSize="12"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
