<Window x:Class="AltPane.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltPane"
        Title="AltPane"
        Width="520"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBgBrush}"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseWheel="Window_PreviewMouseWheel">
  <Window.Resources>
    <Style x:Key="NakedTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource WindowEdgeBrush}"
          BorderThickness="2"
          SnapsToDevicePixels="True">
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource WindowEdgeInnerBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="SidebarHost" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
              Width="76" Margin="0,0,8,0" Visibility="Collapsed"
              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="0,0,8,0">
        <DockPanel>
          <TextBlock x:Name="SidebarTitle" DockPanel.Dock="Top" Text="常用" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="SidebarList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Focusable="False" Cursor="Hand" ToolTip="{Binding ToolTip}" Padding="2,5" Margin="0,1" CornerRadius="8"
                          PreviewMouseLeftButtonDown="SidebarItem_Click"
                          PreviewMouseRightButtonDown="SidebarItem_RightClick"
                          MouseMove="SidebarItem_MouseMove">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                              <Condition Binding="{Binding HoverHighlight, RelativeSource={RelativeSource AncestorType={x:Type local:SwitcherWindow}}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                      <Grid Width="28" Height="28" HorizontalAlignment="Center" Margin="0,2,0,2">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
                          <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Ellipse x:Name="RunningDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-1,-1" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource WindowBgBrush}"
                                 StrokeThickness="1" Visibility="Collapsed"/>
                      </Grid>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Running}" Value="True">
                      <Setter TargetName="RunningDot" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Grid.Row="0" Margin="4,0,4,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="BrandText" Text="AltPane" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock x:Name="SystemText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <Grid Margin="0,4,0,0" MinHeight="28">
            <TextBlock x:Name="SearchPlaceholder"
                       FontSize="18"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource NakedTextBox}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Background="Transparent"
                     PreviewMouseDown="SearchBox_PreviewMouseDown"
                     TextChanged="SearchBox_TextChanged"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="DisplayFilterButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,0" MinWidth="72" Click="DisplayFilter_Click" Visibility="Collapsed"/>
          <Button x:Name="SortButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,0" MinWidth="72" Click="Sort_Click"/>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Column="1" Grid.Row="1">
          <ListBox x:Name="WindowList"
                   Background="Transparent"
                   BorderThickness="0"
                   Focusable="False"
                   IsTextSearchEnabled="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   HorizontalContentAlignment="Stretch"
                   PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                   PreviewMouseDown="List_PreviewMouseDown">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,4" Margin="0,1">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                        </Trigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                            <Condition Binding="{Binding HoverHighlight, RelativeSource={RelativeSource AncestorType={x:Type local:SwitcherWindow}}}" Value="True"/>
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </MultiDataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <EventSetter Event="MouseMove" Handler="Item_MouseMove"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_Click"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="52" ToolTip="{Binding ToolTipText}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="56" Height="32" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" HorizontalAlignment="Left">
                      <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border x:Name="SecondIconBorder" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                            HorizontalAlignment="Right" Visibility="Collapsed">
                      <Image Source="{Binding SecondIcon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock x:Name="SectionText" Text="{Binding Section}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,2"/>
                    <DockPanel>
                      <Border x:Name="DigitChip" DockPanel.Dock="Left" Margin="0,0,6,0" MinWidth="16" Padding="4,0" CornerRadius="4"
                              Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DigitLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WindowBgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Border x:Name="IndexChip" DockPanel.Dock="Left" Margin="0,0,6,0" MinWidth="18" Padding="4,0" CornerRadius="4"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IndexLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Border x:Name="MonitorChip" DockPanel.Dock="Left" Margin="0,0,6,0" Padding="4,1" CornerRadius="6"
                              Background="{Binding MonitorTint}" BorderBrush="{Binding MonitorBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="11" Height="8" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding MonitorBrush}" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Border Height="1.5" VerticalAlignment="Bottom" Background="{Binding MonitorBrush}" Margin="2,0,2,1"/>
                          </Border>
                          <TextBlock Text="{Binding MonitorLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MonitorBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <Button x:Name="RowKill" Tag="kill" DockPanel.Dock="Right" Focusable="False"
                              Style="{DynamicResource DangerButton}" Content="{Binding KillLabel}"
                              Padding="8,2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                      <Border x:Name="BadgeBorder" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <DockPanel x:Name="LoadLine" Margin="0,3,0,0">
                      <Border x:Name="LoadBar" DockPanel.Dock="Left" Width="{Binding BarWidth}" Height="3" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource LoadCalmBrush}"/>
                      <TextBlock Text="{Binding LoadText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ShowSecondIcon}" Value="True">
                    <Setter TargetName="SecondIconBorder" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DigitLabel}" Value="">
                    <Setter TargetName="DigitChip" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IndexLabel}" Value="">
                    <Setter TargetName="IndexChip" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="File">
                    <Setter TargetName="IndexChip" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Section}" Value="">
                    <Setter TargetName="SectionText" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Badge}" Value="">
                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding MonitorLabel}" Value="">
                    <Setter TargetName="MonitorChip" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsApp}" Value="True">
                    <Setter TargetName="LoadLine" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RowKill" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding KillLabel}" Value="">
                    <Setter TargetName="RowKill" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ShowLoad}" Value="False">
                    <Setter TargetName="LoadLine" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Heat}" Value="1">
                    <Setter TargetName="LoadBar" Property="Background" Value="{DynamicResource LoadWarmBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Heat}" Value="2">
                    <Setter TargetName="LoadBar" Property="Background" Value="{DynamicResource LoadHotBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Margin="24"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="Collapsed"/>
      </Grid>

      <StackPanel Grid.Column="1" Grid.Row="2" Margin="4,8,4,0">
        <Border x:Name="ActionHintBar" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
          <TextBlock x:Name="ActionHint" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <DockPanel>
          <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
          <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>
      </StackPanel>
      <Border x:Name="Toast" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="12,6" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource WindowBgBrush}" FontSize="12"/>
      </Border>
    </Grid>
    </Border>
  </Border>
</Window>
