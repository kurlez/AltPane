<Window x:Class="AltPane.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltPane"
        Width="980"
        Height="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseWheel="Window_PreviewMouseWheel">
  <Window.Resources>
    <Style x:Key="NakedTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource StrokeBrush}"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="4,0,4,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="BrandText" Text="AltPane" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock x:Name="SystemText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <Grid Margin="0,4,0,0" MinHeight="28">
            <TextBlock x:Name="SearchPlaceholder"
                       FontSize="18"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource NakedTextBox}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Background="Transparent"
                     PreviewMouseDown="SearchBox_PreviewMouseDown"
                     TextChanged="SearchBox_TextChanged"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SortButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,0" MinWidth="72" Click="Sort_Click"/>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="0.42*"/>
          <ColumnDefinition x:Name="PreviewColumn" Width="0.58*"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <ListBox x:Name="WindowList"
                   Background="Transparent"
                   BorderThickness="0"
                   Focusable="False"
                   IsTextSearchEnabled="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   HorizontalContentAlignment="Stretch"
                   PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                   PreviewMouseDown="List_PreviewMouseDown">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,4" Margin="0,1">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                          <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="False"/>
                          </MultiTrigger.Conditions>
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </MultiTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <EventSetter Event="MouseMove" Handler="Item_MouseMove"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_Click"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="52" ToolTip="{Binding ToolTipText}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock x:Name="SectionText" Text="{Binding Section}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,2"/>
                    <DockPanel>
                      <Border x:Name="BadgeBorder" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <DockPanel x:Name="LoadLine" Margin="0,3,0,0">
                      <Border x:Name="LoadBar" DockPanel.Dock="Left" Width="{Binding BarWidth}" Height="3" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource LoadCalmBrush}"/>
                      <TextBlock Text="{Binding LoadText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="">
                    <Setter TargetName="SectionText" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Badge}" Value="">
                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsApp}" Value="True">
                    <Setter TargetName="LoadLine" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ShowLoad}" Value="False">
                    <Setter TargetName="LoadLine" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Heat}" Value="1">
                    <Setter TargetName="LoadBar" Property="Background" Value="{DynamicResource LoadWarmBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Heat}" Value="2">
                    <Setter TargetName="LoadBar" Property="Background" Value="{DynamicResource LoadHotBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Margin="24"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="Collapsed"/>
        </Grid>

        <Grid x:Name="PreviewRoot" Grid.Column="1" Margin="14,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PreviewProcess" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border x:Name="ThumbHost" Grid.Row="1" Background="{DynamicResource PreviewWellBrush}" CornerRadius="12" ClipToBounds="True">
            <Grid>
              <Image x:Name="CachedPreview" Stretch="Uniform" Visibility="Collapsed" Opacity="0.92"/>
              <TextBlock x:Name="PreviewPlaceholder"
                         Margin="20"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <Border x:Name="MinimizedBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                <TextBlock x:Name="MinimizedBadgeText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </Border>
            </Grid>
          </Border>
          <WrapPanel x:Name="ActionBar" Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="MinButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,8" Click="MenuMin_Click"/>
            <Button x:Name="MaxButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,8" Click="MenuMax_Click"/>
            <Button x:Name="RestoreButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,8" Click="MenuRestore_Click"/>
            <Button x:Name="CloseButton" Style="{DynamicResource ActionButton}" Margin="0,0,8,8" Click="MenuClose_Click"/>
            <Button x:Name="KillButton" Style="{DynamicResource DangerButton}" Margin="0,0,8,8" Click="MenuKill_Click"/>
          </WrapPanel>
        </Grid>
      </Grid>

      <DockPanel Grid.Row="2" Margin="4,12,4,0">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
